# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o Git (está no .gitignore).

# Conexão com o MongoDB Atlas (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority

# Cloudinary, onde ficam as imagens (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Senha da área do professor (use uma senha forte)
ADMIN_PASSWORD=

# Chave que assina os tokens de login. Gere uma aleatória, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar esta chave desconecta todos que estiverem logados.
TOKEN_SECRET=

# Opcional: endereço(s) do site, separados por vírgula, para só eles poderem chamar a API
# CORS_ORIGIN=https://ensinemusica.netlify.app

# Opcional: porta do servidor (padrão 4000)
# PORT=4000
